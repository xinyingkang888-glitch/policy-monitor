  "calendar": [
    {
      "id": "income_tax",
      "months": [
        3,
        4,
        5
      ],
      "title": "办理{previous_year}年度个税汇算",
      "timing": "现行一般办理期为{year}年3月1日至6月30日；预约安排以当年公告为准。",
      "action": "在个人所得税App核对收入、已缴税额和扣除记录；重点检查租房或房贷利息、赡养老人以及MBA在读期间可能涉及的继续教育扣除。先确认资格及夫妻分配，不能把退税视为必然；已完成可忽略或登记完成。",
      "source": "https://www.chinatax.gov.cn/chinatax/n810341/n810760/c3964127/content.html",
      "verified_on": "2026-09-30"
    },
    {
      "id": "income_tax",
      "months": [
        6
      ],
      "title": "{previous_year}年度个税汇算进入最后一个月",
      "timing": "现行一般汇算期截至{year}年6月30日；这是通常申报期，不能解释为此后任何退税都不能申请。",
      "action": "如尚未完成，核对是否需要办理汇算及是否存在应补税款；如已申请退税，检查受理状态和收款银行卡。不要重复申报；已完成可登记完成。",
      "source": "https://fgk.chinatax.gov.cn/zcfgk/c100011/c5238560/5238560/files/f82f550f90d54fa4bbccf2f3d0c3840f.pdf",
      "verified_on": "2026-09-30"
    },
    {
      "id": "deduction_confirmation",
      "months": [
        12
      ],
      "title": "确认{next_year}年度专项附加扣除信息",
      "timing": "每年12月确认下一年度由单位继续办理的专项附加扣除；错过不代表永久失去扣除资格。",
      "action": "在个人所得税App核对并确认下一年度信息，检查租赁地址、夫妻住房扣除分配及赡养老人资格。MBA已经毕业，不能不加核实就将继续教育扣除照搬到下一年。",
      "source": "https://shanxi.chinatax.gov.cn/web/detail/sx-11400-548-1816080",
      "verified_on": "2026-09-30"
    },
    {
      "id": "pension_review",
      "months": [
        11,
        12
      ],
      "title": "复核{year}年度个人养老金缴费与扣除",
      "timing": "年末规划提醒，并非强制缴费事项；按实际缴费年度核对可扣除金额。",
      "action": "如考虑缴存，先结合今年应税收入、实际边际税率和资金使用计划评估是否划算，再核对已缴金额及凭证。不要为了额度而盲目缴满；已缴者检查扣除记录。",
      "source": "https://fgk.chinatax.gov.cn/zcfgk/c100016/c5237114/content.html",
      "verified_on": "2026-09-30"
    },
